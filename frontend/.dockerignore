# ── КОНТЕКСТ СБОРКИ = ТОЛЬКО ГОТОВЫЙ dist + конфиг nginx ─────────────────────
# Образ фронта ничего не собирает, он раздаёт готовое (см. Dockerfile), поэтому
# в контекст не нужны ни исходники, ни node_modules, ни public (его содержимое
# vite уже разложил внутрь dist при локальной сборке).
#
# Список БЕЛЫЙ, а не чёрный: сначала исключаем всё, потом возвращаем нужное.
# Так любой новый файл во frontend/ не утечёт в контекст по недосмотру — раньше
# именно так туда попадали 38 МБ мёртвых GLB и контекст весил 45.8 МБ.
*
!dist
!nginx.conf

# Мусор ОС и локальные секреты не должны просочиться даже через dist
**/.DS_Store
**/Thumbs.db
**/*.local
**/.env
**/.env.*
